{
  "name": "compasu-frontend",
  "displayName": "Compasu Frontend",
  "env": {
    "VITE_API_URL": "@vite_api_url",
    "VITE_SOCKET_URL": "@vite_socket_url"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "nodeVersion": "18.x",
  "installCommand": "npm install",
  "env": {
    "VITE_API_URL": "https://compasu-api.railway.app/api/v1",
    "VITE_SOCKET_URL": "https://compasu-api.railway.app"
  }
}
